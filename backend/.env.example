# Platform Database (PostgreSQL for Docker, SQLite fallback for local test)
DATABASE_URL=postgresql://traffic:trafficpass@localhost:5432/trafficdb
TRAFFIC_DB=traffic.db

# Admin User Seed Credentials
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change-me-long-and-random

# Network & Traffic Source
NETWORK_FILE=network.json
TRAFFIC_SOURCE=simulated        # or: live
TOMTOM_API_KEY=                # TomTom Traffic Flow API Key
TOMTOM_QUOTA_PER_DAY=2500      # Stays strictly under daily free-tier quota (2,500 non-tile req/day)
LIVE_MAX_EDGES=15              # Central edges to poll per refresh
LIVE_TTL_SECONDS=600           # Cache TTL for live readings (10 minutes)
MIN_LIVE_OBS=500               # Minimum live logged observations required for ML retraining

# Rate Limiting & Security
RATE_LOGIN_PER_MIN=20
RATE_API_PER_MIN=300
